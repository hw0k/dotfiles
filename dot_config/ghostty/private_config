# Ghostty Configuration
# Migrated from iTerm2 settings

# Font Configuration
# iTerm2: D2Coding 12
font-family = "D2Coding"
font-size = 12
font-codepoint-map = U+AC00–U+D7A3,U+1100–U+11FF=D2Coding
adjust-cell-height = 10%

# Use bold and italic variants
font-style-bold = true
font-style-italic = true

# Theme: Dracula (from iTerm2)
# Background color: rgb(30, 31, 41) - converted from iTerm2 values
background = 1e1f29

# Foreground color: rgb(230, 230, 230) - converted from iTerm2 values
foreground = e6e6e6

# Cursor color: rgb(187, 187, 187)
cursor-color = bbbbbb

# Cursor style
cursor-style = block
cursor-style-blink = true

# ANSI Colors (Dracula theme from iTerm2)
# Black
palette = 0=#000000
palette = 8=#555555

# Red
palette = 1=#ff5555
palette = 9=#ff5555

# Green
palette = 2=#50fa7b
palette = 10=#50fa7b

# Yellow
palette = 3=#f1fa8c
palette = 11=#f1fa8c

# Blue
palette = 4=#bd93f9
palette = 12=#bd93f9

# Magenta
palette = 5=#ff79c6
palette = 13=#ff79c6

# Cyan
palette = 6=#8be9fd
palette = 14=#8be9fd

# White
palette = 7=#bbbbbb
palette = 15=#ffffff

# Window settings
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# macOS specific
macos-titlebar-style = native
macos-option-as-alt = true

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Copy on select
copy-on-select = clipboard

# Mouse support
mouse-hide-while-typing = true

# Scrollback
scrollback-limit = 10000

# Performance
resize-overlay = never

# Keybindings (common iTerm2 shortcuts)
# New tab
keybind = cmd+t=new_tab

# Close tab
keybind = cmd+w=close_surface

# Next/Previous tab
keybind = cmd+shift+right=next_tab
keybind = cmd+shift+left=previous_tab

# Split pane horizontally
keybind = cmd+d=new_split:right

# Split pane vertically
keybind = cmd+shift+d=new_split:down

# Navigate between panes
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom

# Clear screen
keybind = cmd+k=clear_screen

# Find
keybind = cmd+f=toggle_quick_terminal

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Fullscreen
keybind = cmd+ctrl+f=toggle_fullscreen

# New window
keybind = cmd+n=new_window
keybind = shift+enter=text:\x1b\r
